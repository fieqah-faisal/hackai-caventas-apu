# Copy to .env and fill in. Never commit the real .env.

# --- Firestore / Firebase ---
# Path to the Firebase service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json

# Your Firebase / GCP project id.
FIREBASE_PROJECT_ID=ir-planner-dev

# When set, the Admin SDK talks to the local Firestore emulator instead
# of the cloud. Leave unset/blank to use the real Firestore.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- AI planner (owned by AI team member; backend works without it) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Local storage ---
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# --- Evidence ingestion limits ---
MAX_UPLOAD_BYTES=10485760
