# Copy to .env and fill in. Never commit the real .env.

# --- Firestore / Firebase ---
# Path to the Firebase service-account JSON key file.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/serviceAccount.json

# Your Firebase / GCP project id.
FIREBASE_PROJECT_ID=ir-planner-dev

# When set, the Admin SDK talks to the local Firestore emulator instead
# of the cloud. Leave unset/blank to use the real Firestore.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# --- AI planner: OpenCode Go subscription gateway (OpenAI-compatible) ---
# Get the key from https://opencode.ai/auth (subscribe to Go, copy key).
# Keep it in .env only.
OPENCODE_GO_API_KEY=
OPENCODE_GO_MODEL=deepseek-v4.1-flash
OPENCODE_GO_ENDPOINT=https://opencode.ai/zen/go/v1/chat/completions
# Optional request tuning (defaults shown).
OPENCODE_GO_MAX_TOKENS=4000
OPENCODE_GO_TEMPERATURE=0.2
OPENCODE_GO_TIMEOUT_SECONDS=60

# --- Local storage ---
UPLOAD_DIR=./uploads
REPORT_DIR=./reports

# --- Evidence ingestion limits ---
MAX_UPLOAD_BYTES=10485760
