  "stage_guidance": {
    "assessment": [
      "Determine scope and affected assets.",
      "Identify which accounts, passwords and sessions were exposed."
    ],
    "preservation": [
      "Preserve memory and disk images before re-imaging.",
      "Export relevant auth, endpoint and CRM logs with hashes."
    ],
    "containment": [
      "Isolate the affected endpoint when suspicious activity is evidence-backed.",
      "Revoke stolen sessions and reset saved passwords.",
      "Block malicious domains and IP addresses."
    ],
    "eradication": [
      "Remove malicious files and persistence mechanisms.",
      "Re-image the compromised device only after preservation."
    ],
    "hardening": [
      "Address the weakness that enabled the incident (unmanaged software installs).",
      "Add detection for the observed technique."
    ],
    "restoration": [
      "Restore normal operations and verify security.",
      "Confirm the stolen session can no longer be used."
    ]
  },
  "approved_tools": [
